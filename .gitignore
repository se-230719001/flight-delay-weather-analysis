.gitignore · GITIGNORE
# Secrets: must be ignored BEFORE .env is created
.env
 
# Python
venv/
.venv/
__pycache__/
*.pyc
 
# We keep the data in local and dont push it to github
data/raw/*/*
!data/raw/*/.gitkeep
data/*.db

# M5: run log, cron/Task Scheduler output, lock file
data/pipeline_log.db
logs/
data/pipeline.lock
